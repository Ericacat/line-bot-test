LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# Optional: defaults to the service account project_id.
GOOGLE_CLOUD_PROJECT=
TRANSLATION_ENABLED=false
# Set true ONLY after confirming the same project's Google NMT daily quota is 1500.
# This acknowledges the console setting; it does not create or change a quota.
TRANSLATION_QUOTA_CONFIRMED=false
# Set true to enable speech; false to stop it after redeployment. No daily TTS cap.
TTS_ENABLED=false
# HTTPS production origin, e.g. https://your-bot.vercel.app
PUBLIC_BASE_URL=
# Random secret of at least 32 bytes. Do not commit the actual secret.
AUDIO_URL_SIGNING_SECRET=
# No Redis variables needed.
