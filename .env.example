LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# Optional: defaults to the service account project_id.
GOOGLE_CLOUD_PROJECT=
TRANSLATION_ENABLED=false
# Set true ONLY after confirming the same project's Google NMT daily quota is 1500.
# This acknowledges the console setting; it does not create or change a quota.
TRANSLATION_QUOTA_CONFIRMED=false
# Speech defaults on when unset; false stops it after redeployment. No daily TTS cap.
TTS_ENABLED=true
# Optional override; when omitted, uses Vercel VERCEL_URL. HTTPS origin only.
PUBLIC_BASE_URL=
# Optional override, at least 32 bytes. When omitted, derives from LINE_CHANNEL_SECRET.
# Omit this variable rather than setting it to an empty string.
AUDIO_URL_SIGNING_SECRET=
# No Redis variables needed.
